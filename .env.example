# --- Mapbox ---------------------------------------------------------------
# Token públic de Mapbox (pk.*). El fa servir la PWA i també l'API (Directions).
VITE_MAPBOX_TOKEN=pk.xxx
MAPBOX_TOKEN=${VITE_MAPBOX_TOKEN}

# --- Base de dades --------------------------------------------------------
POSTGRES_USER=petjada
POSTGRES_PASSWORD=petjada
POSTGRES_DB=petjada
POSTGRES_PORT=5432
DATABASE_URL=postgres://petjada:petjada@localhost:5432/petjada

# --- API ------------------------------------------------------------------
# Port de l'API en desenvolupament local (pnpm dev:api; el proxy de Vite hi apunta).
PORT=3000
# Ports publicats pels contenidors (docker compose): PWA i API. Lliures al servidor.
WEB_PORT=7274
API_PORT=7275
CORS_ORIGIN=*
# URL pública de la PWA: redirecció de l'enllaç màgic i enllaços dels correus.
# En local: https://localhost:5173. Amb Docker: http://localhost:7274 o el domini públic.
APP_URL=https://localhost:5173

# Autenticació: access token JWT curt + refresh token rotatiu en cookie httpOnly.
JWT_SECRET=canvia-aixo-en-produccio
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=petjada_refresh
# Posa'l a false només si proves l'API per HTTP sense HTTPS ni proxy.
COOKIE_SECURE=true
# Enllaç màgic i codi de 6 xifres.
LOGIN_TOKEN_TTL_MIN=15
LOGIN_CODE_MAX_ATTEMPTS=5
# Peticions per minut i IP als endpoints d'auth (magic-link, verify-code) i als lleugers (guest, refresh).
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_LIGHT_PER_MIN=30

# Correu (enllaç màgic). Si SMTP_HOST és buit, l'enllaç i el codi surten al log del servidor.
SMTP_HOST=
SMTP_PORT=587
# TLS implícit (true per al port 465; false per a STARTTLS al 587). Per defecte: true només si el port és 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Petjada <no-reply@petjada.app>

# Paràmetres del joc (servidor: tota la validació de punts és aquí)
CAPTURE_RADIUS_M=18
MAX_CAPTURE_ACCURACY_M=30
MAX_WALKING_SPEED_MPS=4
OBJECT_SPACING_M=250
NEARBY_RADIUS_M=10000
COMPLETION_COVERAGE=0.9
COVERAGE_BUFFER_M=20
TURNAROUND_RADIUS_M=30
BONUS_POINTS_PER_KM=20
WALKING_DETOUR_FACTOR=1.3
AUTO_ROUTE_CANDIDATES=6
OBJECT_BASE_POINTS=10
OBJECT_POINTS_PER_STEP=2
OBJECT_POINTS_STEP_M=100

# --- PWA (client) ---------------------------------------------------------
VITE_API_URL=/api
VITE_CAPTURE_RADIUS_M=18
VITE_VISIBILITY_RANGE_M=180
VITE_CAMERA_FOV_DEG=65
VITE_MIN_ACCURACY_M=25
VITE_MAX_WALKING_SPEED_MPS=3
VITE_LOCK_ANGLE_DEG=8
VITE_UNLOCK_ANGLE_DEG=15
VITE_LOCK_HOLD_MS=400
VITE_MOVING_RATE_DPS=30
VITE_ENABLE_SIM=true
# Paràmetres addicionals de la PWA (tots opcionals; valors per defecte al codi)
VITE_TRACK_FLUSH_INTERVAL_MS=15000
VITE_GPS_WINDOW_SIZE=5
VITE_EYE_HEIGHT_M=1.6
VITE_STILL_GPS_INTERVAL_MS=10000
VITE_OBJECT_FLOAT_PERIOD_MS=3000
VITE_HEADING_LPF_ALPHA=0.15
VITE_COMPASS_CALIBRATION_DEG=20
VITE_FOOTPRINT_SPACING_M=3
VITE_STILL_ACCEL_THRESHOLD=0.6
VITE_STILL_AFTER_MS=20000
VITE_SIM_SPEED_MPS=1.2
VITE_SIM_ACCURACY_M=8
VITE_NEARBY_RADIUS_M=10000
